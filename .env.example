# AI PROVIDER CONFIGURATION (VÉRIF237)
# Choices: "gemini" (default) | "openai"
AI_PROVIDER="gemini"

# GEMINI_API_KEY: Required when AI_PROVIDER="gemini"
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required when AI_PROVIDER="openai"
OPENAI_API_KEY="MY_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4o"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FRONTEND API BASE URL (OPTIONAL)
# Option A (Vercel Full-Stack with Serverless Functions): Leave empty or undefined.
# Option B (Split Frontend / Backend, e.g. Railway, Render, Cloud Run):
# VITE_API_URL="https://verif237-backend.up.railway.app"
VITE_API_URL="https://verif237.vercel.app"

# SERVER CONFIGURATION
PORT="3000"
NODE_ENV="production"
